{
  "name": "dsh-image-output-fix",
  "version": "0.3.0",
  "description": "修复发图报 pi-ai does not support image input：把 dsh-host-apiproxy 的 describeImagesWithVision 替换为 v3 有条件识图转述——对话模型不支持图片时用已配置的识图模型（dsh-vision.model，如 aliyun/qwen3.7-flash）把图片转述为文字再发送，模型支持图片时图片原样直发",
  "type": "module",
  "main": "lib/index.js",
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "exports": {
    ".": "./lib/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "scripts": {
    "check": "node --check lib/index.js",
    "patch-run": "node scripts/patch-run.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": ">=22.19.0",
    "dsh": ">=0.1.0-rc.5"
  },
  "license": "MIT"
}